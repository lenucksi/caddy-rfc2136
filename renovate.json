{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":automerge",
    ":automergeDigest",
    ":pinDigests"
  ],
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "pruneStaleBranches": true,
  "ignoreTests": false,
  "labels": ["renovate"],
  "packageRules": [
    {
      "description": "Patch/Minor/Digest/Pin auto-mergen, sobald die Required Checks gruen sind",
      "matchUpdateTypes": ["patch", "minor", "digest", "pin", "lockFile"],
      "automerge": true
    },
    {
      "description": "Major-Updates brauchen einen Menschen (Breaks bei Caddy 3.x / Modul-APIs)",
      "matchUpdateTypes": ["major"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Caddy-Version (Docker-Tags + Builder Image)",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG CADDY_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "caddyserver/caddy"
    },
    {
      "customType": "regex",
      "description": "rfc2136 Modul ist auf einen Commit gepinnt (kein Release-Tag aktuell)",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG RFC2136_VERSION=(?<currentValue>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "caddy-dns/rfc2136"
    },
    {
      "customType": "regex",
      "description": "events-exec Modul ist auf einen Commit gepinnt",
      "managerFilePatterns": ["/^Dockerfile$/"],
      "matchStrings": [
        "ARG EVENTSEXEC_VERSION=(?<currentValue>[0-9a-f]{40})"
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "mholt/caddy-events-exec"
    }
  ]
}
